message: "If you use ReproImage, please cite it as below."
type: software
title: "ReproImage: integrity, provenance and reproducibility checks for scientific images"
version: 0.1.0
date-released: 2026-11-02
authors:
  - family-names: "Sánchez-Núñez"
    given-names: "Pablo"
    orcid: "https://orcid.org/0000-0001-7845-9506"
url: "https://pablosancheznunez.com/reproimage/"
repository-code: "https://github.com/pablosancheznunez/reproimage"
license: MIT
doi: 10.5281/zenodo.23881635
identifiers:
  - type: doi
    value: 10.5281/zenodo.23881635
    description: "Concept DOI: all versions, resolves to the latest"
  - type: doi
